# Microsoft Graph / correo Edenred
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
DESTINATARIO_EMAIL=

# Portales
EDENRED_URL=
EDENRED_USER=
EDENRED_PASSWORD=
PASE_URL=
PASE_USER=
PASE_PASSWORD=
SUPRAMAX_URL=

# Lista JSON. Ejemplo:
# SUPRAMAX_CREDENTIALS=[{"Empresa":"NOMBRE","Usuario":"usuario","Contraseña":"password"}]
SUPRAMAX_CREDENTIALS=

# scrapers/supramax_saldos_rpa.py y scrapers/supramax_dispersion_rpa.py:
# cuántas cuentas/empresas corren en paralelo (una sesión de Chrome por
# cada una). Default conservador si no se define: 3.
SUPRAMAX_MAX_WORKERS=

# "false" para ver Chrome mientras corren los scripts de Supramax (debug
# local). Cualquier otro valor (o vacío) es headless, que es lo normal.
SUPRAMAX_HEADLESS=

# scrapers/supramax_dispersion_rpa.py: minutos que un job puede quedarse
# EN_PROCESO antes de considerarse huérfano y devolverse a PENDIENTE.
# Default si no se define: 10.
SUPRAMAX_DISPERSION_HUERFANO_MIN=

# scrapers/supramax_dispersion_rpa.py: reintentos antes de marcar un job
# FALLIDO en vez de devolverlo a PENDIENTE. Default si no se define: 3.
SUPRAMAX_DISPERSION_INTENTOS_MAX=

# scrapers/supramax_dispersion_rpa.py: cuántos jobs PENDIENTE toma por
# corrida. Default si no se define: el valor de SUPRAMAX_MAX_WORKERS.
SUPRAMAX_DISPERSION_LOTE=

# Captcha
TWOCAPTCHA_API_KEY=

# Ticket Car (Edenred TC+) — API SOAP
# Las nueve cuentas viven en el secreto `control-vehicular-localhost-secrets`
# bajo la llave TICKETCAR_CUENTAS. Esta variable solo se define para depurar
# contra una cuenta suelta; en el servidor se deja vacia.
# Formato: [{"empresa":"NOMBRE","id":"89","token":"GUID"}, ...]
TICKETCAR_CUENTAS=
TICKETCAR_URL=
# La IP se resuelve sola en cada corrida; se fija solo si la salida es por NAT.
TICKETCAR_IP=

# Google Cloud / BigQuery
GCP_PROJECT_ID=
GCP_BUCKET_RESPALDOS=
BQ_DATASET=
BQ_TABLE=
BQ_VIEW_GASTOS=

# Conciliacion manual local
FILE_GASTOS_MANUAL=

# BigQuery: dataset de hechos de la flota (viajes de FleetUp)
GCP_PROJECT_ID=
BQ_DATASET=rpa_utilitarios
BQ_TABLE=consumos_flota
BQ_DATASET_FLOTA=flota

# Ruta del secreto de Control Vehicular, de donde se leen las credenciales del
# API de FleetUp y de la base. Opcional: ya trae un default en el código.
SECRETO_CONTROL_VEHICULAR=

# Ruta al navegador, si no está en la ubicación estándar. Opcional: el código
# también busca el "Chrome for Testing" que descarga Selenium.
CHROME_BINARY=
